{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/s/:slug", "destination": "/app.html" },
    { "source": "/portfolio", "destination": "/app.html" },
    { "source": "/portfolio/:slug", "destination": "/app.html" },
    { "source": "/about", "destination": "/app.html" },
    { "source": "/services", "destination": "/app.html" },
    { "source": "/contact", "destination": "/app.html" },
    { "source": "/auth/login", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:css|js|svg|ico|png|jpe?g|webp|woff2|webmanifest))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(?:index|app)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
