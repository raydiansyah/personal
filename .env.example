# Module: raydiansyah.com runtime environment template
# Purpose: Document every environment value needed for local/deployed frontend, CAPTCHA, and server notification setup
# Used by: Vite browser client, Supabase integration, analytics, and future server-side email function
# Dependencies: Supabase project; Cloudflare Turnstile; optional Google Analytics; approved transactional email provider
# Public functions: None; local environment template only
# Side effects: None; never commit real values to this file

# -----------------------------------------------------------------------------
# Frontend / Vite (safe to expose in browser; use only public Supabase key)
# -----------------------------------------------------------------------------
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_R2_UPLOAD_ENDPOINT=https://YOUR_UPLOAD_WORKER.example.com/presign
VITE_R2_PUBLIC_BASE_URL=https://media.your-domain.com
VITE_TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY

# -----------------------------------------------------------------------------
# Server-side email notification (NEVER prefix these with VITE_)
# Required only when enabling email notification for new contact inquiries.
# Keep these in the hosting provider's secret manager, not in Git or the browser.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=YOUR_RESEND_API_KEY
NOTIFICATION_EMAIL_TO=raydiansyah@gmail.com
NOTIFICATION_EMAIL_FROM=Raydiansyah Website <onboarding@your-verified-domain.com>

# -----------------------------------------------------------------------------
# Optional server-side Supabase administration
# Do not expose this key to the browser and do not add it to VITE_* variables.
# Only needed for trusted server functions, migrations, or scheduled jobs.
# -----------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_SECRET_KEY
TURNSTILE_SECRET_KEY=YOUR_CLOUDFLARE_TURNSTILE_SECRET_KEY

# -----------------------------------------------------------------------------
# Cloudflare R2 server/Worker secrets (NEVER expose with VITE_)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
